{
    "name": "grupo014/shotfest-votaciones",
    "description": "Plugin WordPress para votaciones del jurado ShotFest",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "yoast/phpunit-polyfills": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "ShotfestVotaciones\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ShotfestVotaciones\\Tests\\": "tests/unit/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
